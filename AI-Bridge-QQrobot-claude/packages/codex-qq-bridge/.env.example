# ==========================================
#  Codex QQ Bridge 环境变量配置模板
# ==========================================
# 复制此文件为 .env 并填入你的参数：
#   cp .env.example .env

# 1. QQ 开放平台机器人凭证（必填）
#    在 https://bot.q.qq.com 应用管理后台获取
APP_ID=your_app_id_here
CLIENT_SECRET=your_client_secret_here

# 2. 管理员用户 OpenID（建议首次启动时留空）
#    留空时仅绑定第一个发消息的用户；绑定完成后其他用户不能抢占。
MASTER_OPENID=

# 3. Codex 默认工作目录
CODEX_CWD=/absolute/path/to/your/project

# 4. Codex CLI 路径（默认从 PATH 查找 codex）
# CODEX_BIN=/absolute/path/to/codex

# 5. 安全策略
#    默认仅允许写当前工作区；越权命令会发送 QQ 审批按钮。
CODEX_SANDBOX=workspace-write
CODEX_APPROVAL_POLICY=on-request

# 可选：日志和状态文件位置
# BRIDGE_LOG_DIR=/absolute/path/to/logs
# CODEX_QQ_STATE_FILE=/absolute/path/to/state.json

# QQ 网络默认强制直连，不继承 HTTP_PROXY / HTTPS_PROXY / ALL_PROXY。
# Codex App Server 和 exec 仍会继承这些代理环境变量。
# 仅当 QQ API 确实需要代理时才改为 1。
QQ_TRUST_ENV_PROXY=0

# 可选：仅供 pbs.twimg.com 原图下载使用，不影响保持直连的 QQ API。
# 下载成功后图片会持久化缓存，补发不会再次访问 X 图片 CDN。
# X_MEDIA_PROXY=http://127.0.0.1:7897
# X_MEDIA_CACHE_DIR=~/.config/codex-qq-bridge/x-media-cache

# 6. 群聊日语课程（默认每天 UTC+8 09:00 开启）
# JAPANESE_TUTOR_ROOT=/absolute/path/to/Nihon_go_robot/japanese-tutor
# DAILY_LESSON_ENABLED=1
# DAILY_LESSON_TIME=09:00
# DAILY_LESSON_TIMEZONE=Asia/Shanghai
